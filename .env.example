# PostgreSQL
POSTGRES_DB=signage_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# JWT — must be at least 256-bit (32 chars)
JWT_SECRET=replace-this-with-a-strong-random-secret-key-here
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=prod

# MinIO object storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_strong_password
MINIO_BUCKET=signage-assets
# Public URL browsers use to load images (set to your server IP/domain in production)
MINIO_PUBLIC_URL=http://localhost:9000
