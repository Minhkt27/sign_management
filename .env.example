CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# PostgreSQL
POSTGRES_DB=srt_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# JWT — must be at least 256-bit (32 chars)
JWT_SECRET=replace-this-with-a-strong-random-secret-key-here
JWT_EXPIRATION=28800000
JWT_REFRESH_EXPIRATION=2592000000

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=prod

# MinIO object storage
ADMIN_INITIAL_PASSWORD=change_me_strong_password
TECH_INITIAL_PASSWORD=change_me_strong_password
SUPERADMIN_INITIAL_PASSWORD=change_me_strong_password

# Change this in production — do not leave as the default minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_strong_password
MINIO_BUCKET=signage-assets
# Public URL browsers use to load images (set to your server IP/domain in production)
MINIO_PUBLIC_URL=http://localhost:9000/signage-assets
